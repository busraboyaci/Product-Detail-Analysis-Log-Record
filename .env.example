# ============================================================
# product_detail_log_analysis.py - configuration
# Change the paths below; no need to touch the code.
# Windows example: C:/Users/busra/Documents/logs
# ============================================================

# Directory containing the raw Excel file (REQUIRED)
INPUT_DIR=./input

# Directory where the result file is written (REQUIRED, created if missing)
OUTPUT_DIR=./output

# Specific file name. If empty, the newest Excel file in INPUT_DIR is used.
INPUT_FILE=

# Sheet to read. If empty, the first sheet is used.
SHEET_NAME=

# Sheet name of the output file
OUTPUT_SHEET_NAME=Analysis

# Output file name prefix
OUTPUT_FILE_PREFIX=product_detail_log_analysis

# Does the raw file have a header row? true / false
INPUT_HAS_HEADER=true

# Number of rows to skip at the top (e.g. title/logo rows)
SKIP_ROWS=0

# Date format used in the output file (Python strftime)
# Date only:      %d.%m.%Y
# Date + time:    %d.%m.%Y %H:%M:%S
DATE_FORMAT=%d.%m.%Y %H:%M:%S

# Day-first date parsing (01.02.2025 -> 1 February). true for TR format.
DATE_DAYFIRST=true

# Append a timestamp to the output file name (prevents overwriting)
TIMESTAMP_OUTPUT=true
